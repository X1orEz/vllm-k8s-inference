ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

ARG UID=1000
ARG GID=1000
ARG VLLM_VERSION=0.27.0

ENV MAX_JOBS=2
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    VLLM_TARGET_DEVICE=cpu \
    HF_HOME=/models \
    HF_HUB_CACHE=/models/hub \
    XDG_CACHE_HOME=/cache \
    TORCH_HOME=/cache/torch \
    VLLM_CACHE_ROOT=/cache/vllm \
RUN pip install --upgrade pip wheel \
 && pip install -r /tmp/requirements.txt    PYTHONPATH=/opt/vllm-extras

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git pkg-config libssl-dev libgomp1 curl \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip wheel \
 && pip install --no-binary vllm -r /tmp/requirements.txt

RUN groupadd --gid ${GID} app \
 && useradd --uid ${UID} --gid app --create-home --shell /bin/bash app

RUN mkdir -p /models /cache /opt/vllm-extras \
 && chown -R app:app /models /cache /opt/vllm-extras

COPY --chown=app:app logging/sitecustomize.py /opt/vllm-extras/sitecustomize.py

USER app
WORKDIR /home/app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["python", "-m", "vllm.entrypoints.openai.api_server"]
